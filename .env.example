# Postgres used by migrations, integration tests and the orchestrator.
# `pnpm db:up` starts a server matching this URL (docker-compose, or ONE shared local
# Homebrew postgresql@16 cluster under ~/.local/share/conductor/pgdata when Docker is
# unavailable). Every worktree shares that server; tests create and drop their own
# uniquely named database on it (packages/orchestrator/test/db.ts).
#
# Resolution order (scripts/db.sh and vitest.config.ts): process env > .env > this file.
# The orchestrator process reads only process.env.DATABASE_URL.
DATABASE_URL=postgres://conductor:conductor@localhost:54329/conductor
