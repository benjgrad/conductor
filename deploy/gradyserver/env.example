# ~/deploy/conductor/.env on gradyserver (mode 0600). deploy.sh creates it from this file on the
# first deploy, filling POSTGRES_PASSWORD, and never overwrites it afterwards.
# CONDUCTOR_GIT_SHA is not set here: deploy.sh passes the deployed sha on every run (image tag and
# build arg).

# Password of the `conductor` Postgres role. Generated by deploy.sh (openssl rand -hex 32; hex so
# it is URL-safe inside DATABASE_URL). Changing it here alone does nothing: see the runbook,
# "Rotate POSTGRES_PASSWORD".
POSTGRES_PASSWORD=

# Public origin. Used for the Origin check, cookies, links and /install.sh.
CONDUCTOR_PUBLIC_URL=https://conductor.gradyserver.com

# Auth mode. Informational: compose.yml fixes CONDUCTOR_AUTH=password for the orchestrator.
CONDUCTOR_AUTH=password

# Host port published on 127.0.0.1 (container port 7400). Must equal the upstream port in
# nginx/conductor.gradyserver.com.conf. 3040 verified free by the lead on 2026-10-26 (reso: 3031).
CONDUCTOR_HOST_PORT=3040

# Fixed subnet and gateway of the `conductor` compose network. Verified free on 2026-10-26
# (172.31.0.0/16 belongs to interviewme-agent).
CONDUCTOR_SUBNET=192.168.80.0/24
CONDUCTOR_GATEWAY=192.168.80.1

# The only TCP peer whose X-Forwarded-* headers the orchestrator believes. Must equal
# CONDUCTOR_GATEWAY (Docker's userland proxy connects from the gateway).
CONDUCTOR_TRUSTED_PROXY=192.168.80.1

# Days of nightly dumps backup.sh keeps in ~/deploy/conductor/backups.
BACKUP_KEEP_DAYS=14

# Optional. Discord webhook that ci-deploy.sh posts to when a CI deploy fails or rolls back (the
# maintenance channel personal-os uses). A secret: anyone holding it can post there. Unset, the
# alert only goes to the job log.
DISCORD_WEBHOOK_URL=
