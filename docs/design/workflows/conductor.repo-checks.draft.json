{
  "repo": "github.com/benjgrad/conductor",
  "setup": "pnpm install --frozen-lockfile && (git remote get-url origin >/dev/null 2>&1 || git remote add origin https://github.com/benjgrad/conductor.git) && git fetch -q origin main && git branch -f main origin/main",
  "checks": [
    {
      "name": "Merges cleanly with main",
      "cmd": "git merge-tree --write-tree origin/main HEAD",
      "timeout": "2m"
    },
    {
      "name": "Typecheck",
      "cmd": "pnpm typecheck",
      "timeout": "10m"
    },
    {
      "name": "Lint",
      "cmd": "pnpm lint",
      "timeout": "15m"
    },
    {
      "name": "Tests (affected tiers)",
      "cmd": "CONDUCTOR_CI_TIERED=1 pnpm test",
      "timeout": "30m"
    }
  ]
}
