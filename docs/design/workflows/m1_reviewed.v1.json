{
  "id": "m1_reviewed",
  "version": 1,
  "start": "implement",
  "budget": {
    "usd": 3,
    "minutes": 90,
    "max_loop_retries": 3
  },
  "on_budget_exceeded": "needs_input",
  "states": {
    "implement": {
      "type": "agent",
      "prompt": "ticket_template",
      "tools": ["edit", "bash", "git"],
      "timeout": "30m",
      "on": {
        "done": {
          "goto": "build",
          "requirements": {
            "items": [
              "New code paths have unit tests",
              "No TODO comments in changed files"
            ],
            "on_unmet": {
              "goto": "implement",
              "instruction": "Fix every unmet requirement before anything else, then finish the step again.",
              "retries": 2,
              "else": "needs_input"
            }
          }
        },
        "ask_user": "needs_input",
        "timeout": "needs_input"
      }
    },
    "build": {
      "type": "command",
      "cmd": "npm run build",
      "timeout": "10m",
      "on": {
        "exit_0": "test",
        "fail": {
          "goto": "implement",
          "attach": "output",
          "retries": 3,
          "else": "needs_input"
        }
      }
    },
    "test": {
      "type": "command",
      "cmd": "npm test",
      "timeout": "10m",
      "on": {
        "exit_0": "done",
        "fail": {
          "goto": "implement",
          "attach": "output",
          "retries": 3,
          "else": "needs_input"
        }
      }
    },
    "needs_input": { "type": "human" },
    "done": { "type": "terminal" }
  }
}
