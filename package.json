{
  "name": "conductor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @conductor/web run build",
    "typecheck": "tsc -b",
    "lint": "node scripts/test-slot.js eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:all": "vitest run --mode all",
    "test:watch": "vitest",
    "test:e2e": "e2e/run.sh",
    "db:up": "scripts/db.sh up",
    "db:down": "scripts/db.sh down",
    "db:migrate": "scripts/db.sh migrate",
    "clean": "tsc -b --clean && rm -rf packages/web/dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
