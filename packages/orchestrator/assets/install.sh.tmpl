#!/bin/sh
# conductor daemon installer (M2-T14; ADR-0017 §Daemon distribution), served by the orchestrator
# at /install.sh with its public URL, the daemon version and, for every target it serves, the
# tarball's name and SHA-256 filled in (MR-T15; ADR-0026 §4). It picks this machine's by `uname`.
#
#   curl -fsSL @@PUBLIC_URL@@/install.sh | sh -s -- --token <token> [--service] [--root <dir>]
#
# Installs the daemon into <root>/daemon/<version>, points <root>/daemon/current at it and links
# <root>/bin/conductor-daemon, and installs <root>/bin/conductor-launch (what the service units run;
# the tarball's assets/conductor-launch.sh, the same bytes `service install` writes; ADR-0021 §3).
# With an enrollment token it then enrolls this machine; without
# one it upgrades in place and keeps <root>/machine.json. The daemon is a native binary: it needs
# no Node. It installs none of its prerequisites (git, claude); it says what is missing.
set -eu

PUBLIC_URL='@@PUBLIC_URL@@'
VERSION='@@VERSION@@'
FILE_AARCH64_APPLE_DARWIN='@@FILE_AARCH64_APPLE_DARWIN@@'
SHA256_AARCH64_APPLE_DARWIN='@@SHA256_AARCH64_APPLE_DARWIN@@'
FILE_X86_64_APPLE_DARWIN='@@FILE_X86_64_APPLE_DARWIN@@'
SHA256_X86_64_APPLE_DARWIN='@@SHA256_X86_64_APPLE_DARWIN@@'
FILE_X86_64_UNKNOWN_LINUX_GNU='@@FILE_X86_64_UNKNOWN_LINUX_GNU@@'
SHA256_X86_64_UNKNOWN_LINUX_GNU='@@SHA256_X86_64_UNKNOWN_LINUX_GNU@@'
FILE_AARCH64_UNKNOWN_LINUX_GNU='@@FILE_AARCH64_UNKNOWN_LINUX_GNU@@'
SHA256_AARCH64_UNKNOWN_LINUX_GNU='@@SHA256_AARCH64_UNKNOWN_LINUX_GNU@@'

usage() {
  cat <<EOF
usage: install.sh [--token <token> | --token -] [--service] [--root <dir>]

  --token <token>  enroll this machine with a one-time token from Add a machine
  --token -        read the token from stdin (only when this script is saved to a file:
                   with curl | sh, stdin is the script itself)
  --service        start the daemon at login (launchd on macOS, systemd --user on Linux)
  --root <dir>     install root (default: \$CONDUCTOR_ROOT, else ~/.conductor)

The token can also come from the environment, which keeps it off the command line:
  curl -fsSL $PUBLIC_URL/install.sh | CONDUCTOR_ENROLL_TOKEN=<token> sh
Without a token the script upgrades an existing install and keeps its enrollment.
EOF
}

say() { printf '%s\n' "$*"; }
die() {
  printf 'conductor install: %s\n' "$*" >&2
  exit 1
}

token="${CONDUCTOR_ENROLL_TOKEN:-}"
unset CONDUCTOR_ENROLL_TOKEN
token_stdin=0
service=0
root="${CONDUCTOR_ROOT:-${HOME:-}/.conductor}"
while [ $# -gt 0 ]; do
  case "$1" in
    --token)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      if [ "$2" = - ]; then token_stdin=1; else token="$2"; fi
      shift 2
      ;;
    --token=*)
      token="${1#--token=}"
      [ "$token" = - ] && { token=""; token_stdin=1; }
      shift
      ;;
    --service) service=1; shift ;;
    --root)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      root="$2"
      shift 2
      ;;
    --root=*) root="${1#--root=}"; shift ;;
    -h | --help) usage; exit 0 ;;
    *)
      printf 'conductor install: unknown option %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done
if [ "$token_stdin" = 1 ]; then
  [ -f "$0" ] || die "--token - needs the script saved to a file (with curl | sh, use CONDUCTOR_ENROLL_TOKEN instead)"
  IFS= read -r token || [ -n "$token" ] || die "--token -: no token on stdin"
  [ -n "$token" ] || die "--token -: empty token on stdin"
fi
[ -n "$root" ] || die "no install root: set HOME or pass --root"
case "$root" in /*) ;; *) root="$(pwd)/$root" ;; esac

# ---- this machine's build ----
os="$(uname -s 2>/dev/null || echo unknown)"
arch="$(uname -m 2>/dev/null || echo unknown)"
# A shell under Rosetta reports x86_64 on Apple silicon: install the native build.
if [ "$os" = Darwin ] && [ "$arch" = x86_64 ] &&
  [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = 1 ]; then
  arch=arm64
fi
case "$os/$arch" in
  Darwin/arm64 | Darwin/aarch64) target=aarch64-apple-darwin FILE="$FILE_AARCH64_APPLE_DARWIN" SHA256="$SHA256_AARCH64_APPLE_DARWIN" ;;
  Darwin/x86_64) target=x86_64-apple-darwin FILE="$FILE_X86_64_APPLE_DARWIN" SHA256="$SHA256_X86_64_APPLE_DARWIN" ;;
  Linux/x86_64 | Linux/amd64) target=x86_64-unknown-linux-gnu FILE="$FILE_X86_64_UNKNOWN_LINUX_GNU" SHA256="$SHA256_X86_64_UNKNOWN_LINUX_GNU" ;;
  Linux/aarch64 | Linux/arm64) target=aarch64-unknown-linux-gnu FILE="$FILE_AARCH64_UNKNOWN_LINUX_GNU" SHA256="$SHA256_AARCH64_UNKNOWN_LINUX_GNU" ;;
  *) die "unsupported platform $os/$arch: conductor-daemon is built for macOS (arm64, x86_64) and Linux (x86_64, arm64); on Windows use install.ps1" ;;
esac
[ -n "$FILE" ] && [ -n "$SHA256" ] || die "this orchestrator has no conductor-daemon build for $target"

# ---- prerequisites: list everything missing, then stop ----
missing=""
need() { missing="$missing
  - $*"; }
command -v git >/dev/null 2>&1 || need "git is required"
command -v claude >/dev/null 2>&1 || need "Claude Code (claude) is required: https://claude.com/claude-code"
if command -v curl >/dev/null 2>&1; then fetch=curl
elif command -v wget >/dev/null 2>&1; then fetch=wget
else need "curl or wget is required"; fi
if command -v shasum >/dev/null 2>&1; then hasher="shasum -a 256"
elif command -v sha256sum >/dev/null 2>&1; then hasher=sha256sum
else need "shasum or sha256sum is required"; fi
command -v tar >/dev/null 2>&1 || need "tar is required"
if [ -n "$missing" ]; then
  printf 'conductor install: missing prerequisites (this script installs none of them):%s\n' "$missing" >&2
  exit 1
fi

# ---- download and verify, before anything is written under the root ----
case "$PUBLIC_URL" in
  https://*) proto='=https' ;;
  http://127.0.0.1 | http://127.0.0.1:* | http://localhost | http://localhost:* | http://\[::1\] | http://\[::1\]:*)
    proto='=http,https' ;;
  *) die "refusing to download over a non-https URL: $PUBLIC_URL" ;;
esac
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
url="$PUBLIC_URL/downloads/$FILE"
say "downloading conductor-daemon $VERSION"
if [ "$fetch" = curl ]; then
  curl -fsSL --proto "$proto" -o "$tmp/$FILE" "$url" || die "download failed: $url"
else
  wget -q -O "$tmp/$FILE" "$url" || die "download failed: $url"
fi
got="$($hasher "$tmp/$FILE" | cut -d' ' -f1)"
if [ "$got" != "$SHA256" ]; then
  die "SHA-256 mismatch for $FILE (expected $SHA256, got $got); nothing installed"
fi

# ---- install ----
umask 077
mkdir -p "$root/daemon" "$root/bin"
chmod 700 "$root"
stage="$root/daemon/.$VERSION.tmp.$$"
rm -rf "$stage"
mkdir "$stage"
tar -xzf "$tmp/$FILE" -C "$stage" || { rm -rf "$stage"; die "could not unpack $FILE"; }
[ -x "$stage/bin/conductor-daemon" ] || { rm -rf "$stage"; die "$FILE has no bin/conductor-daemon"; }
[ -f "$stage/assets/conductor-launch.sh" ] || { rm -rf "$stage"; die "$FILE has no assets/conductor-launch.sh"; }
# Before `current` moves: a binary this machine can't run (wrong build, or blocked by the OS) stops
# here, with the old version still current.
"$stage/bin/conductor-daemon" --version </dev/null >/dev/null 2>&1 ||
  { rm -rf "$stage"; die "$FILE does not run on this machine ($os/$arch); nothing changed"; }
rm -rf "$root/daemon/$VERSION"
mv "$stage" "$root/daemon/$VERSION"
# Swap `current` atomically: rename a fresh link over it (plain mv would move into the old dir).
link="$root/daemon/.current.$$"
rm -f "$link"
ln -s "$VERSION" "$link"
mv -T "$link" "$root/daemon/current" 2>/dev/null || mv -h "$link" "$root/daemon/current" ||
  { rm -f "$link"; die "could not point $root/daemon/current at $VERSION"; }
ln -sfn ../daemon/current/bin/conductor-daemon "$root/bin/conductor-daemon"
launch_tmp="$root/bin/.conductor-launch.$$"
cp "$root/daemon/$VERSION/assets/conductor-launch.sh" "$launch_tmp" &&
  chmod 755 "$launch_tmp" && mv -f "$launch_tmp" "$root/bin/conductor-launch" ||
  { rm -f "$launch_tmp"; die "could not install $root/bin/conductor-launch"; }
daemon="$root/bin/conductor-daemon"
say "installed conductor-daemon $VERSION in $root/daemon/$VERSION"

# ---- enroll (the token goes in the environment, never in argv: TD-117) ----
# Children get </dev/null: with curl | sh, stdin is the rest of this script.
if [ -n "$token" ]; then
  CONDUCTOR_ROOT="$root" CONDUCTOR_ENROLL_TOKEN="$token" "$daemon" enroll --url "$PUBLIC_URL" </dev/null ||
    die "enrollment failed (the daemon is installed; get a new token from Add a machine and re-run)"
  token=""
else
  if [ -f "$root/machine.json" ]; then
    say "upgraded in place; enrollment kept ($root/machine.json)"
  else
    say "not enrolled: re-run with --token from Add a machine"
  fi
  if [ "$service" = 0 ] && { [ -f "${HOME:-}/Library/LaunchAgents/com.conductor.daemon.plist" ] ||
    [ -f "${HOME:-}/.config/systemd/user/conductor-daemon.service" ]; }; then
    CONDUCTOR_ROOT="$root" "$daemon" service restart </dev/null ||
      say "warning: could not restart the conductor-daemon service; restart it yourself"
  fi
fi

if [ "$service" = 1 ]; then
  CONDUCTOR_ROOT="$root" "$daemon" service install </dev/null || die "could not install the service"
fi

say ""
say "Add conductor-daemon to your PATH (e.g. in ~/.profile or ~/.zshrc):"
say "  export PATH=\"$root/bin:\$PATH\""
