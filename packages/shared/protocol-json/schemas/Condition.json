{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Condition",
  "definitions": {
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_checks_green"
            },
            "no_checks_after": {
              "type": "string",
              "pattern": "^(\\d+)(ms|s|m|h|d)$"
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_approvals"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "min"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_merged"
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_screenshots"
            },
            "ui_paths": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathGlob"
              }
            },
            "min_pairs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "ui_paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "azure_pipeline_succeeded"
            },
            "pipeline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "pipeline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "jira_fields_set"
            },
            "fields": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PathGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
