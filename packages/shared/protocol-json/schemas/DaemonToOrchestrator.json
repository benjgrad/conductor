  "definitions": {
    "RegisterPayload": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "enrollment_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpu_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mem_total_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_free_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_cpu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_mem_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_concurrent_builds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "daemon_version": {
          "type": "string"
        },
        "claude_code_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "machine_id",
        "hostname",
        "os",
        "arch",
        "tags",
        "cpu_total",
        "mem_total_mb",
        "disk_free_mb",
        "budget_cpu",
        "budget_mem_mb",
        "max_sessions",
        "max_concurrent_builds",
        "daemon_version",
        "claude_code_version"
      ]
    },
    "HeartbeatPayload": {
      "type": "object",
      "properties": {
        "cpu_free": {
          "type": "number",
          "minimum": 0
        },
        "mem_free_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_free_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "fencing_token": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "session_id",
              "fencing_token"
            ]
          }
        }
      },
      "required": [
        "cpu_free",
        "mem_free_mb",
        "disk_free_mb",
        "sessions"
      ]
    },
    "RepoInventoryPayload": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RepoInventoryEntry"
          }
        }
      },
      "required": [
        "repos"
      ]
    },
    "RepoInventoryEntry": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "head_commit": {
          "type": "string"
        },
        "tree_clean": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "path",
        "head_commit",
        "tree_clean"
      ]
    },
    "RequestWorkPayload": {
      "type": "object",
      "properties": {
        "free_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repos_digest": {
          "type": "string"
        },
        "cpu_free": {
          "type": "number",
          "minimum": 0
        },
        "mem_free_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "free_slots",
        "repos_digest",
        "cpu_free",
        "mem_free_mb"
      ]
    },
    "InventoryPayload": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InventoryRepo"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          }
        },
        "hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repos",
        "capabilities",
        "hash"
      ]
    },
    "InventoryRepo": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/definitions/AbsolutePath"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "head_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "mode": {
          "$ref": "#/definitions/WorkingCopyMode"
        }
      },
      "required": [
        "path",
        "remote",
        "default_branch",
        "head_commit",
        "mode"
      ]
    },
    "AbsolutePath": {
      "type": "string",
      "minLength": 2
    },
    "WorkingCopyMode": {
      "type": "string",
      "enum": [
        "reference",
        "checkout"
      ]
    },
    "Capability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cli"
            },
            "name": {
              "$ref": "#/definitions/CapabilityName"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "authed": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "authed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "name": {
              "$ref": "#/definitions/CapabilityName"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "name": {
              "$ref": "#/definitions/CapabilityName"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent"
            },
            "name": {
              "$ref": "#/definitions/CapabilityName"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "claude"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "version"
          ]
        }
      ]
    },
    "CapabilityName": {
      "type": "string",
      "pattern": "^[^\\s:@\\0]{1,200}$"
    },
    "AlertPayload": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "git_tamper"
        },
        "repo": {
          "$ref": "#/definitions/AbsolutePath"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "files": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "at": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "kind",
        "repo",
        "files",
        "at"
