{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "arch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "daemon_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "token",
    "hostname",
    "os",
    "arch",
    "daemon_version"
  ]
}
