{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "conditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/Condition"
      }
    },
    "pr_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": "string"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": [
    "conditions",
    "pr_url",
    "branch"
  ],
  "definitions": {
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_checks_green"
            },
            "no_checks_after": {
              "type": "string",
              "pattern": "^(\\d+)(ms|s|m|h|d)$"
            },
            "no_checks": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "require_mergeable"
                  ]
                },
                "after": {
                  "type": "string",
                  "pattern": "^(\\d+)(ms|s|m|h|d)$"
                }
              },
              "required": [
                "policy",
                "after"
              ],
              "additionalProperties": false
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_approvals"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "min"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_merged"
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_screenshots"
            },
            "ui_paths": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathGlob"
              }
            },
            "min_pairs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "ui_paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "azure_pipeline_succeeded"
            },
            "pipeline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "pipeline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "jira_fields_set"
            },
            "fields": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cmd"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "cmd": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "string",
              "pattern": "^(\\d+)(ms|s|m|h|d)$"
            },
            "needs": {
              "default": "setup",
              "type": "string",
              "enum": [
                "checkout",
                "setup"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "name",
            "cmd"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pr_mergeable"
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "age_below"
            },
            "max": {
              "type": "string",
              "pattern": "^(\\d+)(ms|s|m|h|d)$"
            },
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "max"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PathGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
