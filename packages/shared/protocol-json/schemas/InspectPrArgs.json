{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pr_url": {
      "$ref": "#/definitions/PrUrl"
    },
    "approval_paths": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/ApprovalId"
      },
      "additionalProperties": {
        "minItems": 1,
        "maxItems": 20,
        "type": "array",
        "items": {
          "$ref": "#/definitions/PathGlob"
        }
      }
    }
  },
  "required": [
    "pr_url",
    "approval_paths"
  ],
  "definitions": {
    "PrUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/github\\.com\\/[\\w.-]+\\/[\\w.-]+\\/pull\\/\\d+$"
    },
    "ApprovalId": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "PathGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
