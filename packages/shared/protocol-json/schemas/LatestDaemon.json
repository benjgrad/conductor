{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,64}$"
    },
    "file": {
      "type": "string",
      "pattern": "^conductor-daemon-[0-9A-Za-z._+-]{1,128}\\.tgz$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 104857600
    }
  },
  "required": [
    "version",
    "file",
    "sha256",
    "size"
  ]
}
