{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pr_url": {
      "$ref": "#/definitions/PrUrl"
    },
    "head_sha": {
      "allOf": [
        {
          "$ref": "#/definitions/GitSha"
        }
      ]
    }
  },
  "required": [
    "pr_url"
  ],
  "definitions": {
    "PrUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/github\\.com\\/[\\w.-]+\\/[\\w.-]+\\/pull\\/\\d+$"
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
