      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "when",
        "question"
      ]
    },
    "WorkingCopy": {
      "type": "object",
      "properties": {
        "repo_path": {
          "$ref": "#/definitions/AbsolutePath"
        },
        "mode": {
          "$ref": "#/definitions/WorkingCopyMode"
        }
      },
      "required": [
        "repo_path",
        "mode"
      ]
    },
    "AbsolutePath": {
      "type": "string",
      "minLength": 2
    },
    "WorkingCopyMode": {
      "type": "string",
      "enum": [
        "reference",
        "checkout"
      ]
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "PrUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/github\\.com\\/[\\w.-]+\\/[\\w.-]+\\/pull\\/\\d+$"
    },
    "RunCmdPayload": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workflow_state": {
          "type": "string"
        },
        "cmd": {
          "type": "string"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "require_clean": {
          "type": "boolean",
          "const": true
        },
        "checkout": {
          "type": "object",
          "properties": {
            "sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "setup": {
              "type": [
                "string",
                "null"
              ]
            },
            "last": {
              "type": "boolean"
            }
          },
          "required": [
            "sha",
            "setup",
            "last"
          ]
        }
      },
