        },
        "repo": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "workflow_state": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resume_claude_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "review": {
          "type": "boolean",
          "const": true
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentTransitionOption"
          }
        },
        "working_copy": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkingCopy"
            }
          ]
        },
        "checkout": {
          "type": "object",
          "properties": {
            "sha": {
              "$ref": "#/definitions/GitSha"
            },
            "pr_url": {
              "$ref": "#/definitions/PrUrl"
            },
            "setup": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "sha",
            "pr_url",
            "setup"
          ]
        }
      },
      "required": [
        "command_id",
        "ticket_id",
        "repo",
        "base_ref",
        "branch",
        "workflow_state",
        "prompt",
        "tools",
