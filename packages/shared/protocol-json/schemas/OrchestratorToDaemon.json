  "definitions": {
    "RegisteredPayload": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "last_seq": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "machine_id",
        "last_seq",
        "heartbeat_interval_ms"
      ]
    },
