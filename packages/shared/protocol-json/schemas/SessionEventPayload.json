{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SessionEventPayload",
  "definitions": {
    "SessionEventPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "started"
            },
            "data": {
              "$ref": "#/definitions/StartedEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "claude_session_id"
            },
            "data": {
              "$ref": "#/definitions/ClaudeSessionIdEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "complete_state"
            },
            "data": {
              "$ref": "#/definitions/CompleteStateEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ask_user"
            },
            "data": {
              "$ref": "#/definitions/AskUserEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "no_outcome"
            },
            "data": {
              "$ref": "#/definitions/NoOutcomeEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exit"
            },
            "data": {
              "$ref": "#/definitions/ExitEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cmd_exit"
            },
            "data": {
              "$ref": "#/definitions/CmdExitEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spend"
            },
            "data": {
              "$ref": "#/definitions/SpendEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "action_result"
            },
            "data": {
              "$ref": "#/definitions/ActionResultEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "build_slot"
            },
            "data": {
              "$ref": "#/definitions/BuildSlotEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "heartbeat"
            },
            "data": {
              "$ref": "#/definitions/HeartbeatEventData"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    "StartedEventData": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "worktree_path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "port_range": {
          "type": "object",
          "properties": {
            "base": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "base",
            "count"
          ]
        }
      },
      "required": [
        "command_id",
        "worktree_path",
        "branch",
        "port_range"
      ]
    },
    "ClaudeSessionIdEventData": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "CompleteStateEventData": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/definitions/JsonObject"
        },
        "transition": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ]
    },
    "JsonObject": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/JsonValue"
      }
    },
    "JsonValue": {},
    "AskUserEventData": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question"
      ]
    },
    "NoOutcomeEventData": {
      "type": "object",
      "properties": {
        "last_output": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "last_output"
      ]
    },
    "ExitEventData": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr_tail": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "command_id",
        "code",
        "signal"
      ]
    },
    "CmdExitEventData": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tail": {
          "type": "string"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup_failed": {
          "type": "boolean"
        }
      },
      "required": [
        "command_id",
        "exit_code",
        "signal",
        "timed_out",
        "duration_ms",
        "output_tail"
      ]
    },
    "SpendEventData": {
      "type": "object",
      "properties": {
        "claude_session_id": {
          "type": "string"
        },
        "total_usd": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_read_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_creation_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_creation_tokens"
          ]
        }
      },
      "required": [
        "claude_session_id",
        "total_usd",
        "usage"
      ]
    },
    "ActionResultEventData": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "action": {
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/definitions/JsonObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command_id",
        "action",
        "result",
        "error"
      ]
    },
    "BuildSlotEventData": {
      "type": "object",
      "properties": {
        "waiting": {
          "type": "boolean"
        }
      },
      "required": [
        "waiting"
      ]
    },
    "HeartbeatEventData": {
      "type": "object",
      "properties": {}
    }
  }
}
