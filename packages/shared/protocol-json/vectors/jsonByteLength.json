{
  "function": "jsonByteLength",
  "description": "jsonByteLength(value) → UTF-8 bytes of JSON.stringify(value) (protocol/ws.ts); inputs keep their number spelling",
  "cases": [
    { "input": null, "expected": 4 },
    { "input": true, "expected": 4 },
    { "input": 0, "expected": 1 },
    { "input": -0, "expected": 1 },
    { "input": 1, "expected": 1 },
    { "input": 1.0, "expected": 1 },
    { "input": -1.5, "expected": 4 },
    { "input": 0.1, "expected": 3 },
    { "input": 1e21, "expected": 5 },
    { "input": 1e-7, "expected": 4 },
    { "input": 123456789012345678901234567890, "expected": 22 },
    { "input": 1.7976931348623157e308, "expected": 23 },
    { "input": 5e-324, "expected": 6 },
    { "input": 0.000001, "expected": 8 },
    { "input": 100, "expected": 3 },
    { "input": 1e2, "expected": 3 },
    { "input": 2.50, "expected": 3 },
    { "input": "", "expected": 2 },
    { "input": "abc", "expected": 5 },
    { "input": "é", "expected": 4 },
    { "input": "€", "expected": 5 },
    { "input": "😀", "expected": 6 },
    { "input": "a\"b", "expected": 6 },
    { "input": "\\", "expected": 4 },
    { "input": "\n\r\t\b\f", "expected": 12 },
    { "input": "\u0000\u001f", "expected": 14 },
    { "input": "\u007f", "expected": 3 },
    { "input": "\u2028\u2029", "expected": 8 },
    { "input": "</script>", "expected": 11 },
    { "input": [], "expected": 2 },
    { "input": {}, "expected": 2 },
    { "input": [1,2,3], "expected": 7 },
    { "input": {"a":1,"b":[true,null,{"c":"d"}]}, "expected": 33 },
    { "input": {"é":"ü","k":[1.5,-2,3e3]}, "expected": 29 },
    { "input": {"z":1,"a":2}, "expected": 13 },
    { "input": [{"x":[[[]]]}], "expected": 14 },
    { "input": {"tool":"Bash","input":{"command":"ls -la"}}, "expected": 44 }
  ]
}
