{
  "id": "missing_else",
  "version": 1,
  "start": "work",
  "budget": {
    "usd": 1,
    "minutes": 10,
    "max_loop_retries": 2
  },
  "states": {
    "work": {
      "type": "command",
      "cmd": "make",
      "on": {
        "exit_0": "done",
        "fail": {
          "goto": "work",
          "retries": 2,
          "else": "help"
        }
      }
    },
    "needs_input": {
      "type": "human"
    },
    "done": {
      "type": "terminal"
    }
  }
}
