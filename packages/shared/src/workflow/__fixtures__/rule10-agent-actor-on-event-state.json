{
  "id": "agent_on_event",
  "version": 1,
  "start": "work",
  "budget": { "usd": 1, "minutes": 10, "max_loop_retries": 2 },
  "states": {
    "work": {
      "type": "agent",
      "prompt": "p",
      "on": { "done": "wait", "ask_user": "needs_input" }
    },
    "wait": {
      "type": "event",
      "wait_for": ["ui.approve"],
      "on": {
        "ui.approve": "done",
        "nudge": { "goto": "done", "actor": "agent" }
      }
    },
    "needs_input": { "type": "human" },
    "done": { "type": "terminal" }
  }
}
