{
  "id": "poll_loop",
  "version": 1,
  "start": "work",
  "budget": {
    "usd": 1,
    "minutes": 10,
    "max_loop_retries": 2
  },
  "states": {
    "work": {
      "type": "agent",
      "prompt": "p",
      "on": {
        "done": "wait",
        "ask_user": "needs_input"
      }
    },
    "wait": {
      "type": "event",
      "wait_for": ["ci.green"],
      "timeout": "5m",
      "on": {
        "ci.green": "done",
        "timeout": "work"
      }
    },
    "needs_input": {
      "type": "human"
    },
    "done": {
      "type": "terminal"
    }
  }
}
