{
  "id": "unbudgeted",
  "version": 1,
  "start": "work",
  "budget": {
    "usd": 1,
    "minutes": 10,
    "max_loop_retries": 2
  },
  "states": {
    "work": {
      "type": "agent",
      "prompt": "p",
      "on": {
        "done": "build",
        "ask_user": "needs_input"
      }
    },
    "build": {
      "type": "command",
      "cmd": "make",
      "on": {
        "exit_0": "done",
        "fail": "work"
      }
    },
    "needs_input": {
      "type": "human"
    },
    "done": {
      "type": "terminal"
    }
  }
}
