{
  "id": "bad_ref_path",
  "version": 1,
  "start": "work",
  "budget": {
    "usd": 1,
    "minutes": 10,
    "max_loop_retries": 2
  },
  "states": {
    "work": {
      "type": "command",
      "cmd": "make",
      "on": {
        "exit_0": "produce",
        "fail": "post"
      }
    },
    "produce": {
      "type": "agent",
      "prompt": "p",
      "on": {
        "done": "post",
        "ask_user": "needs_input"
      },
      "result": ["pr_url"]
    },
    "post": {
      "type": "agent",
      "prompt": "p",
      "on": {
        "done": "done",
        "ask_user": "needs_input"
      },
      "input": {
        "url": "$produce.pr_url"
      }
    },
    "needs_input": {
      "type": "human"
    },
    "done": {
      "type": "terminal"
    }
  }
}
