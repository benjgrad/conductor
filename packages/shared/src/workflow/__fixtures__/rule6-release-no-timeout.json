{
  "id": "release_no_timeout",
  "version": 1,
  "start": "work",
  "budget": {
    "usd": 1,
    "minutes": 10,
    "max_loop_retries": 2
  },
  "states": {
    "work": {
      "type": "agent",
      "prompt": "p",
      "on": {
        "done": "wait",
        "ask_user": "needs_input"
      }
    },
    "wait": {
      "type": "event",
      "wait_for": ["pr.approved"],
      "park": true,
      "release_machine": true,
      "on": {
        "pr.approved": "done"
      }
    },
    "needs_input": {
      "type": "human"
    },
    "done": {
      "type": "terminal"
    }
  }
}
